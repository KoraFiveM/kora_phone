{
  "name": "@kora/phone-sdk",
  "version": "1.0.0",
  "description": "Typed SDK for Kora phone iframe apps",
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "files": [
    "dist",
    "src/theme.css",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run build:runtime && node --test test/*.test.mjs",
    "build:runtime": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=runtime/phone.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED"
}
